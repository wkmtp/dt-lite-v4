{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AssemblyRecipe",
  "description": "Zero-code assembly recipe DSL for DT-Lite",
  "type": "object",
  "required": ["version", "steps"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Recipe version (major.minor)"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "description": {"type": "string"},
        "author": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}}
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^step-\\d+$"
          },
          "type": {
            "type": "string",
            "enum": [
              "create_asset", "instantiate_template", "bind_point",
              "deploy_mapping", "deploy_capability",
              "generate_dashboard", "generate_largescreen",
              "configure_alarm", "configure_workflow",
              "configure_ai_tool", "publish_app"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {"type": "string"}
          },
          "input_schema": {"type": "object"},
          "output_schema": {"type": "object"},
          "retry_policy": {
            "type": "object",
            "properties": {
              "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
              "backoff": {"type": "string", "enum": ["exponential", "linear", "fixed"]},
              "jitter": {"type": "string"}
            }
          },
          "rollback_handler": {"type": "string"},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
        }
      }
    }
  }
}
