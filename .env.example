# Environment Variables
# Copy this file to .env and fill in values

# Database
DATABASE_URL=postgresql+asyncpg://dtlite_user:dtlite_pass@postgres:5432/dtlite
POSTGRES_USER=dtlite_user
POSTGRES_PASSWORD=dtlite_pass
POSTGRES_DB=dtlite

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO (Object Storage)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=dtlite-assets

# EMQX (IoT MQTT Broker)
EMQX_HOST=emqx
EMQX_PORT=1883
EMQX_DASHBOARD_PORT=18083

# JWT Auth
SECRET_KEY=change-me-in-production-use-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application
APP_NAME=DT-Lite
APP_VERSION=4.0.0
DEBUG=true

# Backend
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
